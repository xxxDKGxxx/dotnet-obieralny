 {
 "Authentication": {
	 "Jwt": {
		 "Issuer": "LoanHub.Backend",
		 "Audience": "LoanHub.Frontend"
	 }
 },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "log.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
